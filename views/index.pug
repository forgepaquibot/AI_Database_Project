doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Login / Sign Up
    link(rel="stylesheet" href="/indexstyle.css")

  body
    .container
      h1 Welcome to the Database!

      if message
        p.message(role="status")= message

      .form-container
        // Login form
        .form-box
          h2 Login

          form(action="/login" method="POST")
            label(for="login-username") Username
            input#login-username(
              type="text"
              name="username"
              placeholder="Username"
              autocomplete="username"
              maxlength="100"
              required
            )

            label(for="login-password") Password
            input#login-password(
              type="password"
              name="password"
              placeholder="Password"
              autocomplete="current-password"
              required
            )

            button(type="submit") Login

        // Signup form
        .form-box
          h2 Sign Up

          form(action="/signup" method="POST")
            label(for="signup-username") Username
            input#signup-username(
              type="text"
              name="username"
              placeholder="Choose a username"
              autocomplete="username"
              maxlength="100"
              required
            )

            label(for="signup-password") Password
            input#signup-password(
              type="password"
              name="password"
              placeholder="At least 8 characters"
              autocomplete="new-password"
              minlength="8"
              required
            )

            p.password-hint Password must be at least 8 characters, with no spaces.

            button(type="submit") Create Account

    script(src="/index.js")