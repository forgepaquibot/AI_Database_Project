
doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title AI Model Hub
    link(rel="stylesheet" href="/ai_model_style.css")

  body
    // Defaults prevent errors before all backend routes are updated.
    - const installedModels = typeof ollamaModels !== 'undefined' && ollamaModels ? ollamaModels : []
    - const registeredModels = typeof models !== 'undefined' && models ? models : []
    - const ollamaRegisteredModels = registeredModels.filter(model => model.provider === 'ollama')
    - const resourceList = typeof resources !== 'undefined' && resources ? resources : []
    - const jobList = typeof jobs !== 'undefined' && jobs ? jobs : []
    - const pageMessage = typeof message !== 'undefined' ? message : null

    .container
      h1 AI Model Hub

      // Navigation
      .nav-buttons
        a.nav-btn(href="/resources") PDF Uploads
        a.nav-btn(href="/") Back to Login/Sign Up

      if pageMessage
        p.message= pageMessage

      // Register an existing Ollama model
      .section
        h2 Register Ollama Model

        p Select a model already installed and available through Ollama.
        p You do not need to upload its weight file again.

        if installedModels.length
          form(action="/register_ollama_model" method="POST")
            label(for="model_ref") Installed Ollama model
            select#model_ref(name="model_ref" required)
              each item in installedModels
                option(value=item.name)= item.name

            label(for="name") Display name
            input#name(
              type="text"
              name="name"
              placeholder="e.g. Llama 3.2"
            )

            label(for="description") Description
            textarea#description(
              name="description"
              placeholder="Optional model description"
            )

            button(type="submit") Register Model
        else
          p No Ollama models found. Start Ollama and install a model first.

      // Evaluate a model against a PDF
      .section
        h2 Evaluate Model Against PDF

        p Run a benchmark using questions and expected answers
          |  associated with an uploaded PDF.

        if ollamaRegisteredModels.length && resourceList.length
          form(action="/evaluate_model" method="POST")
            label(for="ai_id") AI Model
            select#ai_id(name="ai_id" required)
              each model in ollamaRegisteredModels
                option(value=model.ai_id)= model.name + " (" + model.model_ref + ")"

            label(for="resource_id") PDF Resource
            select#resource_id(name="resource_id" required)
              each resource in resourceList
                option(value=resource.resource_id)= resource.title

            button(type="submit") Run Evaluation
        else
          p Register an Ollama model and upload or select an accessible PDF first.

      // Recent evaluation jobs
      .section
        h2 Evaluation History

        if jobList.length
          .table-wrapper
            table
              thead
                tr
                  th Job ID
                  th Model
                  th PDF
                  th Score
                  th Threshold
                  th Status
                  th Completed
              tbody
                each job in jobList
                  tr
                    td= job.job_id
                    td= job.model_name
                    td= job.resource_title
                    td= job.score == null ? "Not scored" : (job.score * 100).toFixed(1) + "%"
                    td= (job.threshold * 100).toFixed(1) + "%"
                    td
                      span(class="status status-" + job.status)= job.status
                    td= job.completed_at || "Not completed"
        else
          p No evaluation jobs have been run yet.

      // Registered models
      .section
        h2 Registered Models

        if registeredModels.length
          .results
            each model in registeredModels
              .card
                h3= model.name

                if model.description
                  p= model.description

                p Provider: #{model.provider || "legacy file upload"}
                p Date created: #{model.date_created}

                if model.provider === "ollama"
                  p Ollama model: #{model.model_ref}
                  if model.model_digest
                    p Model digest: #{model.model_digest}
                else
                  p Legacy model path: #{model.model_path}

        else
          p No models have been registered yet.

    script(src="/ai_model.js")