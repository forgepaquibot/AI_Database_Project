doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title AI Model Hub
    link(rel="stylesheet" href="/ai_model_style.css")

  body
    - const registeredModels = Array.isArray(models) ? models : []
    - const ollamaRegisteredModels = registeredModels.filter(model => model.provider === 'ollama')
    - const installedModels = Array.isArray(ollamaModels) ? ollamaModels : []
    - const resourceList = Array.isArray(resources) ? resources : []
    - const userResources = Array.isArray(ownedResources) ? ownedResources : []
    - const processJobs = Array.isArray(processingJobs) ? processingJobs : []

    .container
      h1 AI Model Hub

      .nav-buttons
        a.nav-btn(href="/resources") Data Resources
        a.nav-btn(href="/") Back to Login
        a.nav-btn(href="/logout") Logout

      if message
        p.message= message

      .section
        h2 Register an Ollama Model
        p Register a model already installed in the Ollama instance connected to this server. This does not upload model weights.

        if installedModels.length
          form(action="/register_ollama_model" method="POST")
            label(for="model_ref") Installed model
            select#model_ref(name="model_ref" required)
              each item in installedModels
                option(value=item.name)= item.name

            label(for="model_name") Display name
            input#model_name(
              type="text"
              name="name"
              placeholder="e.g. Llama 3.2"
              required
            )

            label(for="model_description") Description
            textarea#model_description(
              name="description"
              rows="2"
              placeholder="Optional description"
            )

            label.share-toggle
              input(type="checkbox" name="is_public" value="1")
              span Make this model public for other users of this app

            button(type="submit") Register Model
        else
          p No Ollama models found. Start Ollama and pull a model first.

      .section
        h2 Process a Resource
        p Processing extracts structured information and creates searchable embeddings. It does not modify the model's weights.

        if ollamaRegisteredModels.length && userResources.length
          form#process-resource-form(
            action="/process_resource"
            method="POST"
          )
            label(for="process-ai-id") Model to connect
            select#process-ai-id(name="ai_id" required)
              each model in ollamaRegisteredModels
                option(value=model.ai_id)= model.name + (model.is_public ? " (public)" : "")

            label(for="process-resource-id") Resource you own
            select#process-resource-id(name="resource_id" required)
              each resource in userResources
                option(value=resource.resource_id)= resource.title + " — " + resource.resource_type + " (" + resource.processing_status + ")"

            button(type="submit") Process Resource and Connect Model
        else
          p Register an Ollama model and upload a resource before processing it.

      .section
        h2 Connect an Already Processed Resource
        p Use a resource that is already indexed with another model. Only accessible, ready resources can be connected.

        if ollamaRegisteredModels.length && resourceList.some(resource => resource.processing_status === 'ready')
          form(action="/link_resource" method="POST")
            label(for="link-ai-id") Model
            select#link-ai-id(name="ai_id" required)
              each model in ollamaRegisteredModels
                option(value=model.ai_id)= model.name

            label(for="link-resource-id") Ready resource
            select#link-resource-id(name="resource_id" required)
              each resource in resourceList
                if resource.processing_status === 'ready'
                  option(value=resource.resource_id)= resource.title + " — " + resource.resource_type

            button(type="submit") Connect Resource
        else
          p No ready resources are available to connect yet.

      .section
        h2 Chat with a Model
        p The model answers normally when no indexed resources are connected. When resources are connected, relevant passages may be supplied as context.

        if ollamaRegisteredModels.length
          form#chat-form
            label(for="chat-ai-id") Model
            select#chat-ai-id(name="ai_id" required)
              each model in ollamaRegisteredModels
                option(value=model.ai_id)= model.name

            label(for="chat-prompt") Your message
            textarea#chat-prompt(
              name="prompt"
              rows="4"
              maxlength="10000"
              placeholder="Ask a question..."
              required
            )

            input#chat-session-id(
              type="hidden"
              name="session_id"
              value=""
            )

            button#chat-submit(type="submit") Send Message

          p#chat-status(aria-live="polite")
          pre#chat-response
          h3 Sources used
          ul#chat-sources
        else
          p Register an Ollama model to start chatting.

      .section
        h2 Resource Processing History

        if processJobs.length
          .table-wrapper
            table
              thead
                tr
                  th Job
                  th Resource
                  th Type
                  th Status
                  th Progress
                  th Created
                  th Completed

              tbody
                each job in processJobs
                  tr
                    td= job.processing_job_id
                    td= job.resource_title
                    td= job.operation
                    td
                      span(class="status status-" + job.status)= job.status
                    td= job.progress_percent + "%"
                    td= job.created_at
                    td= job.completed_at || "Not completed"

                  if job.error_message
                    tr
                      td(colspan="7")= job.error_message
        else
          p No resources have been processed yet.

      .section
        h2 Registered Models

        if registeredModels.length
          .results
            each model in registeredModels
              .card
                h3= model.name

                if model.description
                  p= model.description

                p Provider: #{model.provider}
                p Model reference: #{model.model_ref}
                p Owner: #{model.owner_username || "Unknown"}
                p Visibility: #{model.is_public ? "Public" : "Private"}
                p Origin: #{model.model_origin || "registered"}
                p Date created: #{model.date_created}
        else
          p No models have been registered yet.

    script(src="/ai_model.js")