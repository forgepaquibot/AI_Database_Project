extends layout.pug

block styles
  link(rel='stylesheet' href='/ai_model_style.css')

block content
  header.page-heading
    p.eyebrow MODEL WORKSPACE
    h1 AI Model Hub
    p.lead Register installed Ollama models, index resources, and customize each model's instructions.

  if message
    p.notice(role='status' aria-live='polite')= message

  section.panel
    .panel-heading
      div
        p.eyebrow OLLAMA
        h2 Register an installed model
        p.muted Register a model already installed on the Ollama server. The app-managed embedding model is hidden from this list.
    if ollamaModels.length
      form(action='/register_ollama_model' method='post')
        .form-grid
          label.field(for='installed-model')
            span Installed Ollama model
            select#installed-model(name='model_ref' required)
              option(value='') Choose a model
              each model in ollamaModels
                option(value=model.name || model.model)= model.name || model.model
          label.field(for='registered-model-name')
            span Display name
            input#registered-model-name(type='text' name='name' maxlength='200' placeholder='Optional display name')
          label.field.full-width(for='registered-model-description')
            span Description
            input#registered-model-description(type='text' name='description' maxlength='2000' placeholder='What is this model intended for?')
        label.checkbox-label(for='model-public')
          input#model-public(type='checkbox' name='is_public' value='1')
          span Make this model registration public to other signed-in users
        .form-actions
          button(type='submit') Register model
    else
      .empty-state
        h3 No Ollama models found
        p Start Ollama and install a chat model before registering it here.

  section.panel
    .panel-heading
      div
        p.eyebrow CATALOG
        h2 Registered models
        p.muted Public registrations allow other accounts to access a model available through the same Ollama server.
    if models.length
      .model-grid
        each model in models
          article.model-card
            .card-topline
              span.model-provider= model.provider || 'ollama'
              span.visibility(class=model.is_public ? 'public' : 'private')= model.is_public ? 'Public' : 'Private'
            h3= model.name
            p.model-reference= model.model_ref
            p= model.description || 'No description provided.'
            p.muted Registered by #{model.owner_username || 'Unknown'}
            .card-actions
              a.button(href='/models/' + model.ai_id) Model settings
              a.button.secondary(href='/chat') Chat
      else
        p.muted No models have been registered yet.

  section.panel
    .panel-heading
      div
        p.eyebrow RAG INDEXING
        h2 Process a resource
        p.muted Indexing extracts content and builds embeddings. This is separate from fine-tuning model weights.
    if models.length && ownedResources.length
      form#process-resource-form(action='/process_resource' method='post')
        .form-grid
          label.field(for='process-model')
            span Model
            select#process-model(name='ai_id' required)
              option(value='') Choose a model
              each model in models
                option(value=model.ai_id)= model.name
          label.field(for='process-resource')
            span Resource you own
            select#process-resource(name='resource_id' required)
              option(value='') Choose a resource
              each resource in ownedResources
                option(value=resource.resource_id)= resource.title + ' [' + (resource.processing_status || 'uploaded') + ']'
        .form-actions
          button(type='submit') Index and link resource
          p#processing-status.form-status(role='status' aria-live='polite')
    else
      p.empty-copy Upload a resource and register a model to begin indexing.

    if models.length && readyResources.length
      h3 Link an already indexed resource
      form(action='/link_resource' method='post')
        .form-grid
          label.field(for='link-model')
            span Model
            select#link-model(name='ai_id' required)
              option(value='') Choose a model
              each model in models
                option(value=model.ai_id)= model.name
          label.field(for='link-resource')
            span Ready resource
            select#link-resource(name='resource_id' required)
              option(value='') Choose a ready resource
              each resource in readyResources
                option(value=resource.resource_id)= resource.title
        button(type='submit') Link resource

  section.panel
    .panel-heading
      div
        p.eyebrow ACTIVITY
        h2 Recent indexing jobs
    if processingJobs.length
      .table-wrap
        table
          thead
            tr
              th Resource
              th Operation
              th Status
              th Progress
              th Started
          tbody
            each job in processingJobs
              tr
                td= job.resource_title
                td= job.operation
                td
                  span.status(class='status-' + job.status)= job.status
                td= (job.progress_percent || 0) + '%'
                td= job.started_at || job.created_at || '—'
    else
      p.empty-copy No indexing jobs yet.

  .note-strip
    div
      h2 Want to fine-tune a model?
      p Fine-tuning uses a separate Python training process and is not the same as resource indexing.
    a.button.secondary(href='/training') View training catalog

block scripts
  script(src='/ai_model.js' defer)